<img
  srcset="
    {%- if card_product.featured_media.width >= 320 -%}
      {{ card_product.featured_media | image_url: width: 320 }} 320w,
    {%- endif -%}
    {%- if card_product.featured_media.width >= 480 -%}
      {{ card_product.featured_media | image_url: width: 480 }} 480w,
    {%- endif -%}
    {%- if card_product.featured_media.width >= 600 -%}
      {{ card_product.featured_media | image_url: width: 600 }} 600w,
    {%- endif -%}
    {%- if card_product.featured_media.width >= 800 -%}
      {{ card_product.featured_media | image_url: width: 800 }} 800w
    {%- endif -%}
  "
  src="{{ card_product.featured_media | image_url: width: 600 }}"
  sizes="(min-width: 1170px) 260px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
  alt="{{ card_product.featured_media.alt | escape }}"
  class="motion-reduce default_media"
  width="{{ card_product.featured_media.width }}"
  height="{{ card_product.featured_media.height }}"
  loading="lazy"
>

{% comment %}theme-check-enable ImgLazyLoading{% endcomment %}

{%- if card_product.media[1] != nil
  and card_product.media[1].media_type == 'image'
  and show_secondary_image
-%}

  <img
    data-srcset="
      {%- if card_product.media[1].width >= 320 -%}
        {{ card_product.media[1] | image_url: width: 320 }} 320w,
      {%- endif -%}
      {%- if card_product.media[1].width >= 480 -%}
        {{ card_product.media[1] | image_url: width: 480 }} 480w,
      {%- endif -%}
      {%- if card_product.media[1].width >= 600 -%}
        {{ card_product.media[1] | image_url: width: 600 }} 600w,
      {%- endif -%}
      {%- if card_product.media[1].width >= 800 -%}
        {{ card_product.media[1] | image_url: width: 800 }} 800w
      {%- endif -%}
    "
    data-src="{{ card_product.media[1] | image_url: width: 600 }}"
    src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E"
    sizes="(min-width: 1170px) 260px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
    alt="{{ card_product.media[1].alt | escape }}"
    class="motion-reduce secondary_image lazy-hover-image"
    width="{{ card_product.media[1].width }}"
    height="{{ card_product.media[1].height }}"
    loading="lazy"
  >

{%- endif -%}