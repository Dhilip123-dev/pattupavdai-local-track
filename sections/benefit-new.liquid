{%- liquid
  assign sid = section.id
  assign col = section.settings.col_pr
  assign col_tb = section.settings.col_pr_tb
  assign cl_mb = section.settings.col_pr_mb
  assign border = section.settings.br_radius
 %}
{%- for i in (1..1) -%}
  {%- if section.settings.hidden %}{% break %}{% endif -%}
  <section id="laber_{{sid}}" class="type-benefit {{ section.settings.style }}" style="--color-border:{{ section.settings.cl_border }};--alo-border-radius:{{ border }}px;">
      <div class="{{section.settings.layout}}">
          {%- if section.blocks.size > 0 -%}
            <div class="alo-shipping ">
            <div class="row">
            {% assign index = 0 %}  
            {%- for block in section.blocks -%}
                {%- case block.type -%} 
                {% when 'shipping' %}
                <div class="item item_{{index}} col-sm-{{cl_mb}} col-md-{{col_tb}} col-lg-{{col}} bl_{{block.id}}">
                  <div class="alo-benefit" style="--color-icon:{{ section.settings.cl_icon }}; display: flex !important; flex-direction: row !important; flex-wrap: nowrap !important; align-items: flex-start !important; justify-content: flex-start !important; text-align: left !important; gap: 15px !important;">                
                    {% assign image = block.settings.icon_img %} 
                    <div class="icon icon_img" style="width: 52px !important; height: 52px !important; min-width: 52px !important; min-height: 52px !important; flex-shrink: 0 !important; display: flex !important; align-items: center !important; justify-content: center !important; overflow: hidden !important;">
                      {% if image != blank %}
                        <img 
                          src="{{ image | image_url: width: 150 }}" 
                          srcset="{{ image | image_url: width: 100 }} 1x, {{ image | image_url: width: 200 }} 2x"
                          alt="{{ image.alt | default: block.settings.title | escape }}" 
                          loading="lazy" 
                          width="52" 
                          height="52"
                          style="width: 100% !important; height: 100% !important; object-fit: contain !important; border-radius: {{ border }}px;"
                        >
                      {% else %}
                        {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
                        {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                      {% endif %}
                    </div>
                    <div class="content" style="flex: 1 1 0% !important; min-width: 0 !important; text-align: left !important; word-wrap: break-word !important; overflow-wrap: break-word !important;">
                      <h3 class="title alo-color" style="--alo-color:{{ section.settings.cl_heading }}; margin: 0 0 4px 0 !important; text-align: left !important; word-wrap: break-word !important; overflow-wrap: break-word !important;">{{block.settings.title}}</h3>
                      <p class="alo-color" style="--alo-color:{{ section.settings.cl_text }}; margin: 0 !important; text-align: left !important; word-wrap: break-word !important; overflow-wrap: break-word !important;">{{block.settings.text}}</p>
                    </div>
                  </div>
                </div>
                {% assign index = index | plus: 1 %}
              {%endcase%}	
            {%endfor%} 
             </div>
            </div>
          {%- endif -%}
      </div>
    </section>

    
{%- endfor -%}
{%- render 'section_style' -%} 
{%- schema -%}
  {
    "name": "Benefit",
    "class": "type_shipping",
    "max_blocks": 30,
    "settings": [
      {
        "type": "checkbox",
        "id": "hidden",
        "label": "Hidden Section?",
