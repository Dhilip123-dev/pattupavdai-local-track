      {
      "type": "text",
      "id": "mg_mb",
      "label": "Margin"
      },
      {
      "type": "text",
      "id": "pd_mb",
      "label": "Padding"
      }      
    ],
    "blocks": [
      {
        "type": "shipping",
        "name": "Shipping",
        "settings": [          
          {
            "type": "header",
            "content": "== Icon Options"
          },
          {
            "type": "image_picker",
            "id": "icon_img",
            "label": "Icon Image",
            "info": "Dimension: 52x52"
          },
          {
            "type": "header",
            "content": "== Text Options"
          },
          {
            "type": "text",
            "id": "title",
