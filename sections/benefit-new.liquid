          },
          {
            "value": "vertical",
            "label": "Vertical"
          }
        ]
      },
	  
      {
        "type": "select",
        "id": "col_pr",
        "label": "Shipping columns",
        "default": "3",
        "options": [
          {
            "value": "6",
            "label": "2"
          },
          {
            "value": "4",
            "label": "3"
          },
          {
            "value": "3",
            "label": "4"
          },
          {
            "value": "15",
            "label": "5"
          },
          {
            "value": "2",
            "label": "6"
          }
        ]
      },
      {
        "type": "select",
        "id": "col_pr_tb",
        "label": "Shipping columns Tablet",
        "default": "6",
        "options": [
          {
            "value": "6",
            "label": "2"
          },
          {
            "value": "4",
            "label": "3"
          },
          {
            "value": "3",
            "label": "4"
          }
        ]
      },
		{
        "type": "select",
        "id": "col_pr_mb",
        "label": "Shipping columns mobile",
        "default": "6",
        "options": [
          {
            "value": "12",
            "label": "1"
          },
		  {
            "value": "6",
            "label": "2"
          }
        ]
      },  
      {
        "type": "header",
        "content": "== Design Options"
      },
      
      {
        "type": "select",
        "id": "layout",
        "default": "container",
        "options": [
         {
            "value": "container",
            "label": "Container"
         },
         {
            "value": "full-Width",
            "label": "Full Width"
          }
        ],
        "label": "Layout"
      },
	  {
        "type": "image_picker",
        "id": "bg_image",
        "label": "Background image"
      },	
      {
        "type": "color",
        "id": "cl_bg",
        "label": "Background color",
        "default": "#fff"
      },
      {
        "type": "color",
        "id": "cl_icon",
        "label": "Color icon",
        "default": "#fff"
      },
      {
        "type": "color",
        "id": "cl_heading",
        "label": "Color Heading",
        "default": "#fff"
      },
      {
        "type": "color",
        "id": "cl_text",
        "label": "Color Text",
        "default": "#fff"
      }, 
      {
        "type": "color",
        "id": "cl_border",
        "label": "Color Border",
        "default": "#fff"
      },
      {
      "type": "text",
      "id": "mg",
      "label": "Margin",
      "info":"Margin top, margin right, margin bottom, margin left. If you not use to blank"
      },
      {
      "type": "text",
      "id": "pd",
      "label": "Padding",
      "info":"Padding top, padding right, padding bottom, padding left. If you not use to blank"
      },
      {
      "type": "header",
      "content": "== Design Mobile Options"
