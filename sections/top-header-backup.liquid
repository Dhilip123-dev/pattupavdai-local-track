{% if section.settings.home_page_only == false or template.name == 'index' %}
  {% if section.settings.header_use_top_header %}
  <div class="topbar {% if section.settings.hide_top_header_mobile %}hide-mobile{% endif %}" 
    style="
        --color-border:{{section.settings.cl_border_top}};
        --color-bg:{{section.settings.bg_top_header}};
        --color-text:{{section.settings.cl_text}};
        --color-text-hover:{{section.settings.cl_text_h}};
        ">
    <div class="container {% if section.settings.layout == 'full-width' %}{{section.settings.layout}} {% endif %} " {% if section.settings.custom_width %}style="--alo-container-width:{{ section.settings.container_width }}px;"{% endif %}>
      <div class="row">
        <div class="announcement-bar">
          {%- for block in section.blocks -%}
             
            {% assign hide_mobile = block.settings.hide_mobile %}
            {% assign text_align = block.settings.text_align %}
            {% if block.type == 'top_header_4' and text_align == blank %}
              {% assign text_align = 'topbar-center' %}
            {% endif %}
            {% assign col_setting = block.settings.col %}
            {% if block.type == 'top_header_4' and col_setting == blank %}
              {% assign col_setting = '100%' %}
            {% endif %}
            {% case col_setting %}
                {% when '16%' %}
                    {%- assign block_width = 'col-lg-2 col-md-2 col-12' -%}
                {% when '25%' %}
                    {%- assign block_width = 'col-lg-3 col-md-3 col-12' -%}
                {% when '33%' %}
                    {%- assign block_width = 'col-lg-4 col-md-4 col-12' -%}
                {% when '42%' %}
                    {%- assign block_width = 'col-lg-5 col-md-5 col-12' -%}
                {% when '50%' %}
                    {%- assign block_width = 'col-lg-6 col-md-6 col-12' -%}
                {% when '58%' %}
                    {%- assign block_width = 'col-lg-7 col-md-7 col-12' -%}
                {% when '66%' %}
                    {%- assign block_width = 'col-lg-8 col-md-8 col-12' -%}
                {% when '75%' %}
                    {%- assign block_width = 'col-lg-9 col-md-9 col-12' -%}
                {% when '100%' %}
                    {%- assign block_width = 'col-12' -%}
            {% endcase %}
          {%- case block.type -%}
          	{%- when 'contac_header' -%} 
          		<div class="{{text_align}} {{ block_width }} flex {% if hide_mobile %}hide-mobile{%endif%}">
                    <div class="top_contac">
                      <ul>
                        {%- if block.settings.show_phone -%}
                              <li><a href="tel:{{shop.phone}}"><i class="icon-phone-call"></i> {{shop.phone}}</a></li>
                         {%endif%}
                         {%- if block.settings.show_email -%}
                              <li><a href="mailto:{{shop.email}}"><i class="icon-mail"></i> {{shop.email}}</a></li>
                         {%endif%}
                      </ul>
                    </div>
                  </div>
          	{%- when 'message' -%} 
                  	<div class="wrapper-bar-message {{text_align}} {{ block_width }} flex {% if hide_mobile %}hide-mobile{%endif%}">
                        <p class="announcement-bar__message">
                          {{ block.settings.message_text }} 
                              {%- if  block.settings.text_link != blank -%}
                                <a id="b_{{block.id}}"  class="buttons alo-color alo-color-hover" href="{{block.settings.btn_link}}" style="--alo-color:{{block.settings.color_link}};--alo-color-hover:{{block.settings.color_link_hover}};" target="{{block.settings.open_link}}"
                                   {{ block.shopify_attributes }}>{{block.settings.text_link}}</a>
                              {%- endif -%}
                        </p>
                      </div>
          	{%- when 'top_header_3' -%} 
          		<div class="{{text_align}} {{ block_width }} flex {% if hide_mobile %}hide-mobile{%endif%}">
                    	{% if block.settings.menu_topbar != blank%}
                    	<ul class="topbar-menu">
                          {% assign handle = block.settings.menu_topbar %}     
                          {% for link in linklists[handle].links %}
                              <li><a href="{{link.url}}"> {{ link.title }} </a></li>
                          {% endfor %}
                      </ul>
                    	{%endif%}
                      {% assign type_social = block.settings.type_social | plus: 0 %}
                      {%if block.settings.header_use_social%}
                          {%- if type_social == 1 -%}
                            {% include 'social_link' %}
                          {%- else -%}
                              {% include 'social-sharing' %}
                          {%- endif -%}
                      {% endif %}
                    	
                    </div>
  {%- when 'lang_curr' -%} 
          		<div class="{{text_align}} {{ block_width }} flex {% if hide_mobile %}hide-mobile{%endif%}">
                   
                   {%if block.settings.header_use_language or block.settings.header_use_currency %}
                     {% assign showFlag = block.settings.show_flag %}
                      <ul class="menu-language parent-list">
                        {%if block.settings.header_use_language%}
                          {% render 'language', showFlag:showFlag %} 
                        {% endif %}
                        {%if block.settings.header_use_currency %}
                          {% render 'currency' %}
                        {% endif %}
                       {%if block.settings.show_phone %}
                        <li class="hide-mobile" style="--color-text:{{ block.settings.cl_phone }}"><span>{{ block.settings.text_phone }}</span></li> 
                       {% endif %}  
                      </ul> 
                    {% endif %}
                    {% if block.settings.menu_topbar != blank%}
                    	<ul class="topbar-menu hide-mobile">
                          {% assign handle = block.settings.menu_topbar %}     
                          {% for link in linklists[handle].links %}
                              <li><a href="{{link.url}}"> {{ link.title }} </a></li>
                          {% endfor %}
                      </ul>
                   {%endif%}
                    </div>
          	{%- when 'top_header_4' -%}
              <div class="announcement-full-width {{ block_width }} {{ text_align }} flex {% if hide_mobile %}hide-mobile{% endif %}" style="--announcement-color: {{ block.settings.color_text | default: '#ffffff' }}; --announcement-font-size: {{ block.settings.font_size | default: 14 }}px; --announcement-font-weight: {{ block.settings.font_weight | default: '600' }};">

    <div class="announcement-slider"
         data-speed="{{ block.settings.speed | times: 1000 }}">

        {% if block.settings.text1 != blank %}
            <span class="announcement-item active">
                {{ block.settings.text1 }}
            </span>
        {% endif %}

        {% if block.settings.text2 != blank %}
            <span class="announcement-item">
                {{ block.settings.text2 }}
            </span>
        {% endif %}

        {% if block.settings.text3 != blank %}
            <span class="announcement-item">
                {{ block.settings.text3 }}
            </span>
        {% endif %}

        {% if block.settings.text4 != blank %}
            <span class="announcement-item">
                {{ block.settings.text4 }}
            </span>
        {% endif %}

    </div>

</div>
          {%- endcase -%}
          {%- endfor -%}
          
          
        </div>
      </div>
    </div>
  </div>
  {% style%}
  .alo_slidershow {--height-bar: 60px;}
  .text-horizontal-running{

    position:relative;
    overflow:hidden;
    height:40px;

}

.announcement-full-width {
    width: 100%;
    flex: 0 0 100%;
}

.announcement-slider{

    position:relative;
    width:100%;
    height:40px;
    overflow:hidden;

}

.announcement-item{

    position:absolute;
    width:100%;
    left:0;
    top:0;
    height:100%;

    display:flex;
    justify-content:center;
    align-items:center;

    opacity:0;
    transform:translateX(100px);

    transition: opacity 0.6s cubic-bezier(0.25, 1, 0.5, 1), transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);

    color: var(--announcement-color, #ffffff);
    font-size: var(--announcement-font-size, 14px);
    font-weight: var(--announcement-font-weight, 600);

}

.announcement-item.active{

    opacity:1;
    transform:translateX(0);

}

.announcement-item.hide{

    opacity:0;
    transform:translateX(-100px);

}

.topbar-left .announcement-item {
    justify-content: flex-start;
}
.topbar-center .announcement-item {
    justify-content: center;
}
.topbar-right .announcement-item {
    justify-content: flex-end;
}

@media (max-width: 767px) {
  .text-horizontal-running,
  .announcement-slider {
    height: 35px;
  }
  .announcement-item {
    /* font-size: calc(var(--announcement-font-size, 14px) - 2px) !important; */
    font-size:0.7rem !important;
    letter-spacing:0.9px;
    padding: 0 4px;
    box-sizing: border-box;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
}
  {%endstyle%}
     {% else %} 
    {% style%}
    .alo_slidershow {--height-bar: 0px;}
    {%endstyle%} 
  {% endif %}

{% endif %}
<script>
  document.addEventListener("DOMContentLoaded", function () {

    document.querySelectorAll(".announcement-slider").forEach(function (slider) {

        const items = slider.querySelectorAll(".announcement-item");

        if (items.length <= 1) {
            return;
        }

        let current = 0;
        const speed = Number(slider.dataset.speed);

        setInterval(function () {

            items[current].classList.remove("active");
            items[current].classList.add("hide");

            setTimeout(function () {

                items[current].classList.remove("hide");

                current = (current + 1) % items.length;

                items[current].classList.add("active");

            }, 500);

        }, speed);

    });

});
</script>

