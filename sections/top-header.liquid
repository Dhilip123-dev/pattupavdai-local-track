<script>
  (function () {
    function initAnnouncementSliders() {
      document.querySelectorAll(".announcement-slider").forEach(function (slider) {
        if (slider.dataset.initialized === "true") return;
        slider.dataset.initialized = "true";

        var items = slider.querySelectorAll(".announcement-item");
        if (items.length <= 1) return;

        var current = 0;
        var rawSpeed = Number(slider.dataset.speed);
        var speed = (!rawSpeed || isNaN(rawSpeed) || rawSpeed < 2000) ? 5000 : rawSpeed;
        var timer = null;

        // Ensure ONLY the first item is active initially, all others reset
        items.forEach(function (item, idx) {
          if (idx === 0) {
            item.classList.add("active");
            item.classList.remove("hide");
          } else {
            item.classList.remove("active", "hide");
          }
        });

        function nextSlide() {
          var prev = current;
          current = (current + 1) % items.length;

          // Transition previous item out
          items[prev].classList.remove("active");
          items[prev].classList.add("hide");

          // Transition next item in
          items[current].classList.remove("hide");
          items[current].classList.add("active");

          // Clean up all non-active items after transition finishes
          setTimeout(function () {
            items.forEach(function (item, idx) {
              if (idx !== current) {
                item.classList.remove("active", "hide");
              }
            });
          }, 500);
        }

        function startTimer() {
          stopTimer();
          timer = setInterval(nextSlide, speed);
        }

        function stopTimer() {
          if (timer) {
            clearInterval(timer);
            timer = null;
          }
        }

        startTimer();

        // Pause on mouse hover so user can read without jumping
        slider.addEventListener("mouseenter", stopTimer);
        slider.addEventListener("mouseleave", startTimer);

        // Pause when tab is switched/minimized to prevent background queue collision
        document.addEventListener("visibilitychange", function () {
          if (document.hidden) {
            stopTimer();
          } else {
            startTimer();
          }
        });
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initAnnouncementSliders);
    } else {
      initAnnouncementSliders();
    }
    document.addEventListener("shopify:section:load", initAnnouncementSliders);
  })();
</script>

<script>
  (function() {
    // Reusable Countdown logic that can be copied/used anywhere
    class CountdownTimer {
      constructor(options) {
        this.targetDate = options.targetDate;
        this.startDate = options.startDate;
        this.onTick = options.onTick;
        this.onComplete = options.onComplete;
        this.onComingSoon = options.onComingSoon;
        this.timer = null;
        
        this.start();
      }
      
      start() {
        this.update();
        this.timer = setInterval(() => this.update(), 1000);
      }
      
      update() {
        const now = new Date().getTime();
        const start = this.startDate ? this.startDate.getTime() : null;
        const target = this.targetDate.getTime();
        
        if (start && now < start) {
          // Coming soon state
          const diff = start - now;
          if (typeof this.onComingSoon === 'function') {
            this.onComingSoon(this.calculateTime(diff), diff);
          }
        } else if (now >= target) {
          // Completed state
          clearInterval(this.timer);
          if (typeof this.onComplete === 'function') {
            this.onComplete();
          }
        } else {
          // Active state (counting down to targetDate)
          const diff = target - now;
          if (typeof this.onTick === 'function') {
            this.onTick(this.calculateTime(diff), diff);
          }
        }
      }
      
      calculateTime(ms) {
        const totalSecs = Math.floor(ms / 1000);
        return {
          days: Math.floor(totalSecs / 86400),
          hours: Math.floor((totalSecs % 86400) / 3600),
          minutes: Math.floor((totalSecs % 3600) / 60),
          seconds: totalSecs % 60
        };
      }
      
      stop() {
        if (this.timer) {
          clearInterval(this.timer);
          this.timer = null;
        }
      }
    }

    // Slide up carousel class for mobile view
    class OffersCarousel {
      constructor(offersContainer) {
        this.container = offersContainer;
        this.items = Array.from(offersContainer.querySelectorAll('.announcement-bar-countdown__offer-item'));
        this.intervalTime = parseInt(offersContainer.dataset.mobileInterval) || 5000;
        this.currentIndex = 0;
        this.interval = null;
        
        if (this.items.length <= 1) return;
        this.init();
      }
      
      init() {
        this.resizeHandler = () => this.handleResize();
        this.handleResize();
        window.addEventListener('resize', this.resizeHandler);
        this.container.addEventListener('mouseenter', () => this.stop());
        this.container.addEventListener('mouseleave', () => this.start());
      }
      
      handleResize() {
        if (window.innerWidth <= 1024) {
          this.start();
        } else {
          this.stop();
        }
      }
      
      start() {
        if (this.interval) return;
        if (window.innerWidth > 1024) return;
        this.interval = setInterval(() => this.next(), this.intervalTime);
      }
      
      stop() {
        if (this.interval) {
          clearInterval(this.interval);
          this.interval = null;
        }
      }
      
      destroy() {
        this.stop();
        if (this.resizeHandler) {
          window.removeEventListener('resize', this.resizeHandler);
        }
      }
      
      next() {
        const currentItem = this.items[this.currentIndex];
        this.currentIndex = (this.currentIndex + 1) % this.items.length;
        const nextItem = this.items[this.currentIndex];
        
        currentItem.classList.remove('is-active');
        currentItem.classList.add('is-leaving');
        
        nextItem.classList.add('is-active');
        nextItem.classList.remove('is-leaving');
        
        setTimeout(() => {
          currentItem.classList.remove('is-leaving');
        }, 500);
      }
    }

    // Main section initialization
    function initAnnouncementBar(bar) {
      const blockId = bar.id;
      if (blockId) {
        window.ShopifyCountdownTimers = window.ShopifyCountdownTimers || {};
        window.ShopifyCountdownCarousels = window.ShopifyCountdownCarousels || {};

        let cleanedUp = false;
        if (window.ShopifyCountdownTimers[blockId]) {
          window.ShopifyCountdownTimers[blockId].stop();
          delete window.ShopifyCountdownTimers[blockId];
          cleanedUp = true;
        }
        if (window.ShopifyCountdownCarousels[blockId]) {
          window.ShopifyCountdownCarousels[blockId].destroy();
          delete window.ShopifyCountdownCarousels[blockId];
          cleanedUp = true;
        }
        if (cleanedUp) {
          delete bar.dataset.initialized;
        }
      }

      if (bar.dataset.initialized === 'true') return;
      bar.dataset.initialized = 'true';

      const timerWrapper = bar.querySelector('.announcement-bar-countdown__timer-wrapper');
      const offersContainer = bar.querySelector('.announcement-bar-countdown__offers');
      
      if (offersContainer && blockId) {
        window.ShopifyCountdownCarousels[blockId] = new OffersCarousel(offersContainer);
      }
      
      if (timerWrapper) {
        const parseNum = (val) => {
          const parsed = parseInt(val);
          return isNaN(parsed) ? null : parsed;
        };

        const startY = parseNum(timerWrapper.dataset.startYear);
        const startM = parseNum(timerWrapper.dataset.startMonth);
        const startD = parseNum(timerWrapper.dataset.startDay);
        const startH = parseNum(timerWrapper.dataset.startHour);
        const startMin = parseNum(timerWrapper.dataset.startMinute);
        
        const endY = parseNum(timerWrapper.dataset.endYear);
        const endM = parseNum(timerWrapper.dataset.endMonth);
        const endD = parseNum(timerWrapper.dataset.endDay);
        const endH = parseNum(timerWrapper.dataset.endHour);
        const endMin = parseNum(timerWrapper.dataset.endMinute);

        // If essential fields are missing, hide the timer wrapper and center the offers
        if (startY === null || startM === null || startD === null ||
            endY === null || endM === null || endD === null) {
          console.warn("Countdown timer: Missing start/end year, month, or day. Timer not started.");
          timerWrapper.style.display = 'none';
          const container = bar.querySelector('.announcement-bar-countdown__container');
          if (container) container.classList.add('justify-center');
          return;
        }
        
        const startDate = new Date(startY, startM - 1, startD, startH || 0, startMin || 0, 0);
        const endDate = new Date(endY, endM - 1, endD, endH || 0, endMin || 0, 0);

        if (isNaN(startDate.getTime()) || isNaN(endDate.getTime())) {
          console.warn("Countdown timer has invalid start or end date.");
          timerWrapper.style.display = 'none';
          const container = bar.querySelector('.announcement-bar-countdown__container');
          if (container) container.classList.add('justify-center');
          return;
        }
        
        const labelText = bar.querySelector('[id^="timer-label-text-"]');
        const timerBox = bar.querySelector('[id^="timer-box-"]');
        const messageEl = bar.querySelector('[id^="timer-message-"]');
        
        const daysEl = bar.querySelector('[id^="days-"]');
        const hoursEl = bar.querySelector('[id^="hours-"]');
        const minutesEl = bar.querySelector('[id^="minutes-"]');
        const secondsEl = bar.querySelector('[id^="seconds-"]');
        
        const hideOnComplete = timerWrapper.dataset.hideOnComplete === 'true';
        const comingSoonMsg = timerWrapper.dataset.comingSoonMsg;
        const activeMsg = timerWrapper.dataset.activeMsg;
        const completeMsg = timerWrapper.dataset.completeMsg;
        
        function pad(num) {
          return String(num).padStart(2, '0');
        }
        
        function render(time) {
          if (daysEl) daysEl.textContent = pad(time.days) + 'D';
          if (hoursEl) hoursEl.textContent = pad(time.hours) + 'H';
          if (minutesEl) minutesEl.textContent = pad(time.minutes) + 'M';
          if (secondsEl) secondsEl.textContent = pad(time.seconds) + 'S';
        }
        
        const timerInstance = new CountdownTimer({
          startDate: startDate,
          targetDate: endDate,
          onComingSoon: (time) => {
            if (labelText) labelText.textContent = comingSoonMsg || "Coming Soon";
            if (timerBox) timerBox.style.display = 'inline-flex';
            if (messageEl) messageEl.style.display = 'none';
            render(time);
          },
          onTick: (time) => {
            if (labelText) labelText.textContent = activeMsg || "Offer Ends In";
            if (timerBox) timerBox.style.display = 'inline-flex';
            if (messageEl) messageEl.style.display = 'none';
            render(time);
          },
          onComplete: () => {
            if (hideOnComplete) {
              timerWrapper.style.display = 'none';
              // Check if offers should be centered now that timer is hidden
              const container = bar.querySelector('.announcement-bar-countdown__container');
              if (container) container.classList.add('justify-center');
            } else {
              if (labelText) labelText.textContent = "";
              if (timerBox) timerBox.style.display = 'none';
              if (messageEl) {
                messageEl.style.display = 'block';
                messageEl.innerHTML = completeMsg || "Offer Expired!";
              }
            }
          }
        });

        if (blockId) {
          window.ShopifyCountdownTimers[blockId] = timerInstance;
        }
      }
    }

    // Initialize all announcement bars on load
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.announcement-bar-countdown').forEach(initAnnouncementBar);
    });

    // Theme Editor re-init
    document.addEventListener('shopify:section:load', (event) => {
      const section = event.target.querySelector('.announcement-bar-countdown');
      if (section) {
        initAnnouncementBar(section);
      }
    });
  })();
</script>

