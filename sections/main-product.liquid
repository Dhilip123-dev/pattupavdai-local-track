                    /* 5. SOCIAL PROOF, VISITORS & SHIPPING POLICY */
                    .alo_flash-sold svg,
                    .product-page-info__visitors .visitors > svg {
                        width: 20px !important;
                        height: 20px !important;
                        max-width: 20px !important;
                        max-height: 20px !important;
                        flex: 0 0 20px;
                        display: block;
                    }

                    .alo_flash-sold,
                    .product-page-info__visitors .visitors {
                        display: flex;
                        align-items: center;
                        gap: 8px;
                    }

                    @media screen and (max-width: 767px) {
                        .alo_flash-sold svg,
                        .product-page-info__visitors .visitors > svg {
                            width: 20px !important;
                            height: 20px !important;
                            max-width: 20px !important;
                            max-height: 20px !important;
                            flex: 0 0 20px;
                        }
