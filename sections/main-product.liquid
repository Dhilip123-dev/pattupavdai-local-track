{% schema %}
 {
   "name": "Product information",
"class":"laber-product-information",
	"settings": [
		 {
           "type": "header",
           "content": "== Setting"
           },
           {
           "type": "checkbox",
           "id": "products-before-after",
           "label": "Products before after",
           "default": true
           },
           {
           "type": "color",
           "id": "cl_bg",
           "label": "Background color",
           "default": "#fff"
           },
           {
           "type": "color",
           "id": "cl_border",
           "label": "Border color",
           "default": "#fff"
           }, 
           {
           "type": "header",
           "content": "== Setting PC",
           "info":"Margin"
           },
           {
           "type": "text",
           "id": "mg",
           "label": "Margin",
           "info":"Margin top, margin right, margin bottom, margin left. If you not use to blank"
           },
           {
           "type": "text",
           "id": "pd",
           "label": "Padding",
           "info":"Padding top, padding right, padding bottom, padding left. If you not use to blank"
           },
           {
             "type": "range",
             "id": "bd",
             "label": "Border radius",
             "min": 0,
             "max": 50,
             "step": 1,
             "unit": "px",
             "default": 5
         },
           {
           "type": "header",
           "content": "== Design Mobile Options"
           },
           {
           "type": "text",
           "id": "mg_mb",
           "label": "Margin"
           },
