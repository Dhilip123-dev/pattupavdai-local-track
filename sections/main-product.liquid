                            margin-top: 4px;
                            font-size: 10px;
                        }
                    }

                    .product-shipping-info {
                        margin: 4px 0 0;
                        padding: 0;
                        font-size: 12px;
                    }

                    .product-shipping-info a {
                        color: #222;
                        text-decoration: none;
                    }

                    .product-shipping-info a:hover {
                        text-decoration: underline;
                    }

                    /* 6. PRODUCT DESCRIPTION ACCORDION */
                    .pp-product-description-accordion {
                        width: 100%;
                        border-bottom: 1px solid #e5e5e5;
                    }

                    .pp-product-description-summary {
                        display: flex;
                        align-items: center;
                        justify-content: space-between;
                        padding: 18px 0;
                        cursor: pointer;
                        font-size: 14px;
                        font-weight: 500;
                    }

                    .pp-product-description-summary .pp-plus-icon,
                    .pp-product-description-summary .pp-minus-icon {
                        font-size: 14px;
                        transition: transform 0.3s ease, opacity 0.3s ease;
                    }

                    .pp-product-description-summary .pp-minus-icon {
                        display: none;
                    }

                    .pp-product-description-accordion.active .pp-product-description-summary .pp-plus-icon {
                        display: none;
                    }

                    .pp-product-description-accordion.active .pp-product-description-summary .pp-minus-icon {
                        display: inline-block;
                    }

                    .pp-product-description-content {
                        max-height: 0;
                        overflow: hidden;
                        transition: max-height 0.3s ease;
                    }

                    /* 7. CUSTOM ACCORDIONS */
                    .custom-accordion {
                        width: 100%;
                    }

                    .custom-accordion-item {
                        border-bottom: 1px solid #e5e5e5;
                        background: transparent;
                    }

                    .custom-accordion-item:last-child {
                        border-bottom: none;
                    }

                    .custom-accordion-summary {
                        display: flex;
                        align-items: center;
                        justify-content: space-between;
                        padding: 18px 0;
                        cursor: pointer;
                    }

                    .custom-accordion-title {
                        display: flex;
                        align-items: center;
                        gap: 12px;
                        font-size: 14px;
                        font-weight: 500;
                        justify-content: flex-start;
                    }

                    .custom-accordion-toggle {
                        position: relative;
                        width: 20px;
                        height: 20px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                    }

                    .custom-accordion-toggle i {
                        position: absolute;
                        top: 50%;
                        left: 50%;
                        transform: translate(-50%, -50%);
                        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease;
                        font-size: 14px;
                        line-height: 1;
                    }

                    .custom-accordion-plus-icon {
                        opacity: 1;
                        transform: translate(-50%, -50%) rotate(0deg);
                    }

                    .custom-accordion-minus-icon {
                        opacity: 0;
                        transform: translate(-50%, -50%) rotate(-90deg);
                    }

                    .custom-accordion-item.active .custom-accordion-plus-icon {
                        opacity: 0;
                        transform: translate(-50%, -50%) rotate(90deg);
                    }

                    .custom-accordion-item.active .custom-accordion-minus-icon {
                        opacity: 1;
                        transform: translate(-50%, -50%) rotate(0deg);
                    }

                    .custom-accordion-content {
                        max-height: 0;
                        overflow: hidden;
                        transition: max-height 0.3s ease;
                    }

                    .custom-accordion-inner {
                        padding: 0 0 16px 0;
                        font-size: 13px;
                    }

                    .custom-accordion-info-img {
                        width: 20px;
                        height: 20px;
                        object-fit: contain;
                        display: flex;
                    }

                    .custom-accordion-icon {
                        width: 20px;
                        height: 20px;
                        min-width: 20px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                    }

                    /* 8. PRODUCT BENEFITS */
                    .product-benefits-wrapper {
                        width: 100%;
                        margin: 0 0 16px 0;
                        padding: 0;
                        box-sizing: border-box;
                    }

                    .product-benefits-wrapper .custom-benefits {
                        width: 100%;
                        margin: 0;
                        padding: 6px 12px;
                        background: #faf8fb;
                        border-radius: 5px;
                        box-sizing: border-box;
                        overflow: hidden;
                    }

                    .product-benefits-wrapper .custom-benefits-inner {
                        width: 100%;
                        margin: 0;
                        padding: 0;
                        display: flex;
                        align-items: center;
                        justify-content: space-between;
                        box-sizing: border-box;
                    }

                    .product-benefits-wrapper .custom-benefit-item {
                        position: relative;
                        flex: 1 1 0;
                        width: 33.333%;
                        min-width: 0;
                        margin: 0;
                        padding: 4px 14px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        gap: 7px;
                        box-sizing: border-box;
                    }

                    .product-benefits-wrapper .custom-benefit-item:first-child {
                        padding-left: 0;
                    }

                    .product-benefits-wrapper .custom-benefit-item:last-child {
                        padding-right: 0;
                    }

                    .product-benefits-wrapper .custom-benefit-item:not(:last-child)::before {
                        content: "";
                        position: absolute;
                        top: 50%;
                        right: 0;
                        width: 1px;
                        height: 30px;
                        background: #d5d5d5;
                        transform: translateY(-50%);
                    }

                    .product-benefits-wrapper .custom-benefit-icon {
                        width: 28px;
                        height: 28px;
                        min-width: 28px;
                        min-height: 28px;
                        flex: 0 0 28px;
                        display: block;
                        object-fit: contain;
                    }

                    .product-benefits-wrapper .custom-benefit-title {
                        margin: 0;
                        padding: 0;
                        font-size: 14px;
                        line-height: 1.2;
                        font-weight: 500;
                        color: #111;
                        white-space: nowrap;
                        text-align: center;
                    }

                    @media (max-width: 991px) {
                        .product-benefits-wrapper {
                            margin-bottom: 14px;
                        }
                        .product-benefits-wrapper .custom-benefits {
                            padding: 5px 8px;
                        }
                        .product-benefits-wrapper .custom-benefit-item {
                            padding: 3px 10px;
                            gap: 6px;
                        }
                        .product-benefits-wrapper .custom-benefit-item:first-child {
                            padding-left: 0;
                        }
                        .product-benefits-wrapper .custom-benefit-item:last-child {
                            padding-right: 0;
                        }
                        .product-benefits-wrapper .custom-benefit-icon {
                            width: 26px;
