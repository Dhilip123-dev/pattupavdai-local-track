                    </style>

                    {%- for block in section.blocks -%}
                      {% if block.type == 'show_price' or block.type == 'show_reviews' or block.type == 'text_countdown_html' %}
                        {% if pp_price_meta_open == false and pp_image_rendered == false %}
                          <div class="pp-price-meta-layout">
                            <div class="pp-price-meta-left">
                          {% assign pp_price_meta_open = true %}
                        {% endif %}
                      {% else %}
                        {% if pp_price_meta_open == true %}
                            </div><!-- end pp-price-meta-left -->
                            {% if final_image_src != blank and pp_image_rendered == false %}
                              <div class="pp-price-meta-right">
                                <div 
                                    class="pp-conditional-image" 
                                    data-conditional-product-image
                                    {% if is_pattupavadai_dynamic %}
                                        data-pattupavadai-image="true"
                                        data-default-src="{{ current_pavadai_default }}"
                                        data-large-src="{{ current_pavadai_large }}"
                                        {% if variant_sizes_json != blank %}
                                            data-variant-sizes='{{ variant_sizes_json | strip_newlines }}'
                                        {% endif %}
                                    {% endif %}
                                >
                                    <div class="pp-preview-image-wrapper" data-js-open-image-preview>
                                        <img
                                            src="{{ final_image_src }}"
                                            alt="{{ product.title | escape }}"
                                            loading="eager"
                                            width="280"
                                            height="280"
                                            data-js-preview-img
                                        >
                                        <span class="pp-tap-to-preview-btn">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                                            Tap to preview
                                        </span>
                                    </div>
                                </div>
                              </div>
                              {% assign pp_image_rendered = true %}
                            {% endif %}
                          </div><!-- end pp-price-meta-layout -->
                          {% assign pp_price_meta_open = false %}
                        {% endif %}
                      {% endif %}

                      {%- case block.type -%}
                        {%- when '@app' -%}
