<!-- =========================================================================
     CONSOLIDATED CUSTOM SCRIPTS (ALL SCRIPTS IN ONE BLOCK)
     ========================================================================= -->
<script id="pp-consolidated-custom-scripts">
(function() {
  /* 1. Product Description Accordion */
  function initProductDescriptionAccordion() {
    document.querySelectorAll(".pp-product-description-summary").forEach(function(summary) {
      if (summary.dataset.accordionInit === 'true') return;
      summary.dataset.accordionInit = 'true';

      summary.addEventListener("click", function() {
        const accordion = summary.parentElement;
        if (!accordion) return;
        const content = accordion.querySelector(".pp-product-description-content");
        if (!content) return;

        if (accordion.classList.contains("active")) {
          content.style.maxHeight = "0px";
          accordion.classList.remove("active");
        } else {
          content.style.maxHeight = content.scrollHeight + "px";
          accordion.classList.add("active");
        }
      });
    });
  }

  /* 2. Custom Accordions (International Shipments, Return & Exchange, Disclaimer) */
  function initCustomAccordions() {
    document.querySelectorAll(".custom-accordion-summary").forEach(function(summary) {
      if (summary.dataset.accordionInit === 'true') return;
      summary.dataset.accordionInit = 'true';

      summary.addEventListener("click", function() {
        const container = summary.closest(".custom-accordion");
        const onlyOne = container ? container.dataset.onlyOne === "true" : true;
        const accordion = summary.closest(".custom-accordion-item");
        if (!accordion) return;
        const content = accordion.querySelector(".custom-accordion-content");
        if (!content) return;

        if (accordion.classList.contains("active")) {
          content.style.maxHeight = "0px";
          accordion.classList.remove("active");
        } else {
          if (onlyOne && container) {
            container.querySelectorAll(".custom-accordion-item.active").forEach(function(activeItem) {
              if (activeItem !== accordion) {
                const activeContent = activeItem.querySelector(".custom-accordion-content");
                if (activeContent) {
                  activeContent.style.maxHeight = "0px";
                }
                activeItem.classList.remove("active");
              }
            });
          }
          content.style.maxHeight = content.scrollHeight + "px";
          accordion.classList.add("active");
        }
      });
    });
  }

  /* 3. Product Image Preview Modal */
  function initImagePreviewModal() {
    const modal = document.getElementById('ppImagePreviewModal');
    const modalImg = document.getElementById('ppModalPreviewImg');
    const closeBtn = document.getElementById('ppImageModalClose');

    if (!modal || !modalImg) return;

    if (modal.dataset.initialized === 'true') return;
    modal.dataset.initialized = 'true';

    if (modal.parentElement !== document.body) {
      document.body.appendChild(modal);
    }

    function openModal(trigger) {
      const targetImg = trigger.querySelector('img');
      if (!targetImg) return;

      const imageSrc =
        targetImg.currentSrc ||
        targetImg.src ||
        targetImg.getAttribute('src');

      if (!imageSrc) return;

      modalImg.src = imageSrc;
      modalImg.alt = targetImg.alt || 'Product Image Preview';

      modal.classList.add('active');
      modal.setAttribute('aria-hidden', 'false');

      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.remove('active');
      modal.setAttribute('aria-hidden', 'true');

      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';

      setTimeout(function() {
        if (!modal.classList.contains('active')) {
          modalImg.removeAttribute('src');
        }
      }, 200);
    }

    document.addEventListener('click', function(event) {
      const trigger = event.target.closest('[data-js-open-image-preview]');
      if (trigger) {
        event.preventDefault();
        event.stopPropagation();
        openModal(trigger);
        return;
      }

      if (event.target.closest('#ppImageModalClose')) {
        event.preventDefault();
        closeModal();
        return;
      }

      if (event.target === modal) {
        closeModal();
      }
    }, false);

    document.addEventListener('keydown', function(event) {
      if (event.key === 'Escape' && modal.classList.contains('active')) {
        closeModal();
      }
    }, false);
  }

  {% if is_pattupavadai_dynamic %}
  /* 4. Pattupavadai Dynamic Size Switcher */
  function initPattupavadaiImageSwitch() {
    const container = document.querySelector('[data-conditional-product-image][data-pattupavadai-image="true"]');
    if (!container) return;

    let img = container.querySelector('img');
    const defaultSrc = container.getAttribute('data-default-src');
    const largeSrc = container.getAttribute('data-large-src');

    if (!img && (defaultSrc || largeSrc)) {
      img = document.createElement('img');
      img.alt = {{ product.title | json }};
      img.loading = 'lazy';
      img.width = 280;
      img.height = 280;
      const wrapper = container.querySelector('.pp-preview-image-wrapper') || container;
      wrapper.appendChild(img);
    }
    if (!img) return;

    let variantSizesMap = {};
    try {
      const rawMap = container.getAttribute('data-variant-sizes');
      if (rawMap) {
        variantSizesMap = JSON.parse(rawMap);
      }
    } catch(e) {
      console.warn('Could not parse variant sizes map', e);
    }

    const largeSizes = ['11y', '12y', '13y', '14y', '15y', '16y', '17y', '18y', '19y', '20y', 's', 'm', 'l'];

    function updatePattupavadaiImage() {
      let selectedSize = '';

      const sizeInputs = document.querySelectorAll('input[type="radio"]:checked, select, .swatch-element.active, .option-item.active, [data-option-index]');
      sizeInputs.forEach(function(el) {
        const val = (el.value || el.getAttribute('data-value') || el.innerText || '').toLowerCase().trim();
        if (val) {
          const cleanVal = val.replace(/\s+/g, '');
          if (largeSizes.includes(cleanVal) || ['1y','2y','3y','4y','5y','6y','7y','8y','9y','10y'].includes(cleanVal)) {
            selectedSize = cleanVal;
          }
        }
      });

      if (!selectedSize) {
        const variantInput = document.querySelector('input[data-js-product-variant-input], input[name="id"]');
        if (variantInput && variantInput.value) {
          const varId = variantInput.value;
          if (variantSizesMap[varId]) {
            selectedSize = (variantSizesMap[varId] || '').toLowerCase().trim();
          }
        }
      }

      if (selectedSize && largeSizes.includes(selectedSize)) {
        if (img.getAttribute('src') !== largeSrc) {
          img.setAttribute('src', largeSrc);
        }
      } else {
        if (img.getAttribute('src') !== defaultSrc) {
          img.setAttribute('src', defaultSrc);
        }
      }
    }

    const productForm = document.querySelector('form[data-type="add-to-cart-form"], .js_product_single, form[action*="/cart/add"]');
    if (productForm) {
      productForm.addEventListener('change', updatePattupavadaiImage);
      productForm.addEventListener('click', function() {
        setTimeout(updatePattupavadaiImage, 50);
      });
    }

    document.addEventListener('change', function(e) {
      if (e.target && (e.target.matches('input[name*="id"], input[name*="option"], select, input[type="radio"]'))) {
        updatePattupavadaiImage();
      }
    });

    const variantInput = document.querySelector('input[data-js-product-variant-input], input[name="id"]');
    if (variantInput) {
      const observer = new MutationObserver(function() {
        updatePattupavadaiImage();
      });
      observer.observe(variantInput, { attributes: true, attributeFilter: ['value'] });
    }

    updatePattupavadaiImage();
  }
  {% endif %}

  function initAll() {
    initProductDescriptionAccordion();
    initCustomAccordions();
    initImagePreviewModal();
    {% if is_pattupavadai_dynamic %}
    initPattupavadaiImageSwitch();
    {% endif %}
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
})();
</script>
